{
  "manifest_version": 3,
  "name": "repo2rakugo",
  "version": "0.1.1",
  "description": "Send a GitHub repository to repo2rakugo.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://*.workers.dev/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "repo2rakugo"
  }
}
